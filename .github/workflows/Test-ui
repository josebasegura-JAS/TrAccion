name: UI Tests

on:
  workflow_dispatch:

jobs:
  ui-tests:
    name: Playwright Electron UI tests without EXE
    runs-on: windows-latest

    env:
      CI: "true"
      NODE_ENV: development
      NPM_CONFIG_AUDIT: "false"
      NPM_CONFIG_FUND: "false"

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Setup Python for native dependencies
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        shell: pwsh
        run: |
          npm ci --include=dev --no-audit --no-fund

      - name: Show versions
        shell: pwsh
        run: |
          node --version
          npm --version
          npm exec -- playwright --version
          npm exec -- electron --version

      - name: Compile Electron main process
        run: npm exec -- tsc -p electron/tsconfig.json

      - name: Run UI tests
        run: npm run test:e2e:electron

      - name: Upload Playwright report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-electron-ui-report
          path: |
            playwright-report-electron
            test-results
          if-no-files-found: ignore
